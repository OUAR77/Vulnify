# === Production settings (override in your .env) ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-random-secret

# Database (default: SQLite for dev, PostgreSQL for production)
# DATABASE_URL=postgresql://vulnify:vulnify_secret@db:5432/vulnify

# Database password (used in docker-compose)
DB_PASSWORD=vulnify_secret

# Domain for CORS (JSON array)
CORS_ORIGINS=["http://localhost:8000"]

# Site URL (used for emails, links, sitemap)
SITE_URL=https://vulnify.es

# === Optional ===
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development

# Admin seed secret (set a strong random value to protect the /api/admin/seed endpoint)
# Only needed if you want to use the /api/admin/seed endpoint
ADMIN_SEED_SECRET=
ADMIN_PASSWORD=admin123456
ADMIN_EMAIL=admin@vulnify.com

# Uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.gif,.pdf,.txt,.zip,.md

# === AI ===
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:14b
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# === Stripe (pagos) ===
# 1. Crea cuenta gratis en https://dashboard.stripe.com/register
# 2. Ve a https://dashboard.stripe.com/test/apikeys → copia "sk_test_..."
# 3. Ejecuta: python scripts/setup_stripe.py sk_test_tuclave
# 4. Instala CLI: https://stripe.com/docs/stripe-cli
# 5. Corre: stripe listen --forward-to localhost:8000/api/stripe/webhook
# 6. Copia el "whsec_..." que te da el CLI
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_STARTER_YEARLY=price_...
# STRIPE_PRICE_PROFESIONAL_MONTHLY=price_...
# STRIPE_PRICE_PROFESIONAL_YEARLY=price_...
PLATFORM_COMMISSION_PERCENT=10.0

# === SendGrid (emails) ===
# Crea cuenta en https://sendgrid.com, vea API Keys y crea una con acceso completo
# SENDGRID_API_KEY=SG.xxxxx
