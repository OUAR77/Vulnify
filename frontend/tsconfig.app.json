{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/components/ui/bento-pricing.tsx",
    "src/components/ui/error-boundary.tsx",
    "src/components/ui/radial-orbital-timeline.tsx",
    "src/components/ui/ruixen-footer03.tsx",
    "src/components/ui/save-button.tsx",
    "src/components/ui/sparkles.tsx",
    "src/components/ui/timeline-animation.tsx",
    "src/components/ui/vertical-cut-reveal.tsx",
    "src/components/ui/liquid-text.tsx",
    "src/components/ui/horizon-hero-section.tsx",
    "src/components/ui/pricing-section-4.tsx"
  ]
}
